# ============================================================
#  Vision Line Follower - Ortam Değişkenleri
# ============================================================
#
#  Kullanım:
#    1. Bu dosyayı .env olarak kopyalayın:
#       cp .env.example .env
#
#    2. Değerleri ihtiyacınıza göre düzenleyin
#
#    3. Program otomatik olarak .env dosyasını okuyacaktır
#
# ============================================================

# -------------------- Seri Port Ayarları --------------------
# Arduino'nun bağlı olduğu port
# Raspberry Pi'de genellikle: /dev/ttyACM0 veya /dev/ttyUSB0
SERIAL_PORT=/dev/ttyACM0

# Haberleşme hızı (Arduino ile aynı olmalı)
BAUD_RATE=9600

# -------------------- Kamera Ayarları --------------------
# Kamera çözünürlüğü
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# -------------------- Web Sunucu --------------------
# Flask sunucu portu
WEB_PORT=5000

# Sunucu adresi (0.0.0.0 = tüm arayüzler)
WEB_HOST=0.0.0.0

# -------------------- Kırmızı Renk Algılama (HSV) --------------------
# Açık kırmızı aralığı
RED1_H_MIN=0
RED1_H_MAX=10
RED1_S_MIN=120
RED1_V_MIN=70

# Koyu kırmızı aralığı
RED2_H_MIN=170
RED2_H_MAX=180
RED2_S_MIN=120
RED2_V_MIN=70

# Minimum algılama alanı (piksel kare)
MIN_DETECTION_AREA=1500

# -------------------- Loglama --------------------
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log dosyası (boş bırakılırsa sadece konsola yazar)
LOG_FILE=logs/vision.log
