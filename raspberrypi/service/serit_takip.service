# ============================================================
#  SERIT TAKIP ROBOTU - Systemd Servis Dosyasi (v2.2)
# ============================================================
#
#  NOT: Bu dosya kurulum.sh tarafindan otomatik olusturulur.
#  Manuel kurulum icin asagidaki adimlari izleyin.
#
#  MANUEL KURULUM:
#  1. Bu dosyayi kopyalayin ve kullanici/dizin bilgilerini duzenleyin
#  2. sudo cp serit_takip.service /etc/systemd/system/
#  3. sudo systemctl daemon-reload
#  4. sudo systemctl enable serit_takip.service
#  5. sudo systemctl start serit_takip.service
#
# ============================================================

[Unit]
Description=Vision Line Follower - Web Yonetim Arayuzu v2.2
After=network.target
Wants=network-online.target

[Service]
Type=simple

# DIKKAT: Asagidaki degerleri kendi sisteminize gore degistirin
User=pi
Group=pi
WorkingDirectory=/home/pi/vision-line-follower/raspberrypi

# Ana uygulama
ExecStart=/usr/bin/python3 -m web.app

# Hata durumunda yeniden baslat
Restart=always
RestartSec=5

# Ortam degiskenleri
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/vision-line-follower/raspberrypi
Environment=LOG_LEVEL=INFO
Environment=LOG_FILE=/var/log/vision-line-follower/app.log

# Log ciktisi
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vision-line-follower

# Durdurma ayarlari
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
