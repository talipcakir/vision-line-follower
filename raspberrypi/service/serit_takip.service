# ============================================================
#  SERIT TAKIP ROBOTU - Systemd Servis Dosyasi (v2.1)
# ============================================================
#
#  Bu dosya Raspberry Pi acildiginda web yonetim arayuzunun
#  otomatik olarak baslamasini saglar.
#
#  KURULUM:
#  sudo cp serit_takip.service /etc/systemd/system/
#  sudo systemctl daemon-reload
#  sudo systemctl enable serit_takip.service
#  sudo systemctl start serit_takip.service
#
# ============================================================

[Unit]
Description=Vision Line Follower - Web Yonetim Arayuzu v2.1
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi

# Calisma dizini
WorkingDirectory=/home/pi/vision-line-follower/raspberrypi

# Calistirilacak komut
ExecStart=/usr/bin/python3 -m web.app

# Hata durumunda yeniden baslat
Restart=always
RestartSec=5

# Ortam degiskenleri
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/vision-line-follower/raspberrypi
Environment=LOG_LEVEL=INFO
Environment=LOG_FILE=/var/log/vision-line-follower/app.log

# Log ciktisi
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vision-line-follower

# Durdurma ayarlari
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
